# Copy to .env and fill in real values: cp .env.example .env

# Where settings come from:
#   local      - config/local.yaml (default; for `go run` on your machine)
#   production - TASKFLOW_* environment variables (the container; see DockerCompose.yaml)
TASKFLOW_APP_ENVIRONMENT=local

# Secrets never go in YAML, so every environment reads them from here.
# docker compose also uses TASKFLOW_DATABASE_PASSWORD as the Postgres password.
TASKFLOW_DATABASE_PASSWORD=changeme
JWT_SECRET_KEY=changeme-at-least-32-bytes-of-random-text

# Used by the integration tests (TASKFLOW_INTEGRATION=1), not by the app.
TASKFLOW_DATABASE_HOST=localhost
TASKFLOW_DATABASE_PORT=54432
TASKFLOW_DATABASE_NAME=taskflow_dev
TASKFLOW_DATABASE_USER=taskflow
TASKFLOW_DATABASE_SSLMODE=disable
