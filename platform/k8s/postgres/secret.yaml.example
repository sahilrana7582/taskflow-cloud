# Copy to secret.yaml (gitignored) and set your own values:
#   cp secret.yaml.example secret.yaml
# The migration Job puts the password inside a URL, so stick to letters and digits.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: taskflow
type: Opaque
stringData:
  POSTGRES_USER: taskflow
  POSTGRES_PASSWORD: changeme
  POSTGRES_DB: taskflow
