# Copy to secret.yaml (gitignored) and set a real value:
#   cp secret.yaml.example secret.yaml
# The app refuses to start with fewer than 32 bytes. Generate one with:
#   openssl rand -base64 48
apiVersion: v1
kind: Secret
metadata:
  name: taskflow-secret
  namespace: taskflow
type: Opaque
stringData:
  JWT_SECRET_KEY: changeme-at-least-32-bytes-of-random-text
