# ------------------------------------------------------------------
# Secrets & environment
# Never commit real credentials. Commit .env.example with placeholders.
# In AWS, real values live in Secrets Manager / SSM Parameter Store.
# ------------------------------------------------------------------
.env*
!.env.example
*.env

# Private keys, certificates, keystores
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
.netrc

# AWS credentials (use OIDC in CI, SSO/profiles locally — never keys in repo)
.aws/
# Access-key CSVs downloaded from the IAM console
*accessKeys*.csv
*credentials*.csv
rootkey.csv

# ------------------------------------------------------------------
# Go
# ------------------------------------------------------------------
# Compiled binaries
/bin/
/dist/
/build/
/taskflow
/main
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries and coverage output
*.test
*.out
coverage.*
cover.*
*.coverprofile
/test-results/

# Go workspace file (local multi-module setups)
go.work
go.work.sum

# Dependency vendoring (uncomment if you decide not to commit vendor/)
# /vendor/

# Live-reload tool (air) build dir
/tmp/
.air.toml.local

# ------------------------------------------------------------------
# Docker / local runtime data
# ------------------------------------------------------------------
docker-compose.override.yml
compose.override.yml
/pgdata/
/.docker-data/
/volumes/

# ------------------------------------------------------------------
# Terraform
# State and plan files store every attribute in PLAINTEXT, including
# passwords and keys, even when no .tf file mentions a secret.
# Keep .terraform.lock.hcl COMMITTED so provider versions are pinned.
# ------------------------------------------------------------------
# Provider binaries, downloaded modules, and the cached backend config
**/.terraform/*

# Local state, backups, and per-workspace state
*.tfstate
*.tfstate.*
terraform.tfstate.d/
.terraform.tfstate.lock.info

# Saved plans (binary) and their JSON renders from `terraform show -json`
*.tfplan
*.tfplan.json
tfplan
tfplan.*
plan.out
plan.json

# Crash logs dump full API requests/responses, which can include secrets
crash.log
crash.*.log

# Variable values: commit *.tfvars.example with placeholders instead
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local overrides meant for one machine only
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config and API tokens (`terraform login` writes credentials.tfrc.json)
.terraformrc
terraform.rc
credentials.tfrc.json
.terraform.d/

# ------------------------------------------------------------------
# Kubernetes / EKS / Helm (Phase 7)
# ------------------------------------------------------------------
kubeconfig
kubeconfig*
*.kubeconfig
.kube/
# Rendered/decoded secrets — commit manifests that reference secrets, not values
*secret*.decoded.yaml
*.secret.yaml
charts/*.tgz
.helm/

# ------------------------------------------------------------------
# CI/CD & tooling artifacts
# ------------------------------------------------------------------
# Vulnerability / SBOM scan output (trivy, grype, govulncheck)
trivy-results.*
*.sarif
sbom.*
# Load-test results (k6, vegeta, hey)
/loadtest/results/

# ------------------------------------------------------------------
# Logs
# ------------------------------------------------------------------
*.log
logs/

# ------------------------------------------------------------------
# Editors & OS
# ------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
